generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Confession {
  id          String    @id @default(cuid())
  slug        String    @unique
  senderKey   String?   @unique
  fromName    String    @default("")
  toName      String
  message     String
  theme       String    @default("rose")
  response    String?
  // balasan tertulis penerima (loop dua arah) — muncul di pantauan pengirim
  reply       String?
  repliedAt   DateTime?
  views       Int       @default(0)
  reportCount Int       @default(0) // >=3 → konten disembunyikan sementara
  // opt-in tampil di Dinding Kangenin (cuma nama & tema, ISI SURAT TIDAK) — mesin FOMO
  isPublic    Boolean   @default(false)
  // kirim terjadwal: surat terkunci sampai waktu ini (countdown kejutan)
  unlockAt    DateTime?
  createdAt   DateTime  @default(now())
  openedAt    DateTime?
  respondedAt DateTime?

  reactions ReactionCount?
}

// Reaksi pengunjung Dinding Kangenin per confess — kolom tetap biar
// increment-nya atomik tanpa upsert baris per reaksi.
model ReactionCount {
  id           String     @id @default(cuid())
  confessionId String     @unique
  confession   Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  heart        Int        @default(0)
  laugh        Int        @default(0)
  cry          Int        @default(0)
  bloom        Int        @default(0)
}

// Open When Letters: satu set berisi beberapa surat,
// tiap surat terbuka dengan jeda mingguan sejak penerima mulai.
model LetterSet {
  id          String    @id @default(cuid())
  slug        String    @unique
  senderKey   String    @unique
  fromName    String    @default("")
  toName      String
  theme       String    @default("rose")
  views       Int       @default(0)
  reportCount Int       @default(0) // >=3 → konten disembunyikan sementara
  createdAt   DateTime  @default(now())
  openedAt    DateTime? // pertama kali link dibuka (mampir)
  startedAt   DateTime? // penerima menekan "mulai" → jam sandiwaranya berdetak
  letters     Letter[]
}

model Letter {
  id         String    @id @default(cuid())
  setId      String
  set        LetterSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  order      Int
  title      String
  body       String
  unlockDays Int       @default(0) // 0 = langsung, 7 = minggu ke-1, dst.
  views      Int       @default(0)
  openedAt   DateTime?
  reply      String? // balasan penerima untuk surat ini
  repliedAt  DateTime?

  @@index([setId])
}

// Kado digital 4 tipe: buket bunga, photobox, kue tiup lilin, love coupons.
// Isi spesifik per tipe disimpan sebagai JSON string (SQLite tidak punya Json).
model Gift {
  id          String    @id @default(cuid())
  slug        String    @unique
  senderKey   String    @unique
  type        String // bouquet | photobox | cake | coupons
  fromName    String    @default("")
  toName      String
  theme       String    @default("rose")
  data        String    @default("{}") // konten kado (JSON per tipe)
  progress    String    @default("{}") // status pemakaian, mis. kupon terpakai
  views       Int       @default(0)
  reportCount Int       @default(0) // >=3 → konten disembunyikan sementara
  createdAt   DateTime  @default(now())
  openedAt    DateTime?
}

// ─────────────────────────────────────────────────────────────────────────────
// Kado — penerus model Gift (yang masih nyimpan data sebagai JSON string) untuk
// semua variasi fitur buka-kado. Konfigurasi interaksi tiap tipe disimpan di
// kadoData (JSONB), jadi menambah kadoType baru cukup ganti VALUE — schema
// tidak perlu diubah / tidak perlu migrasi.
//
// kadoType yang direncanakan + contoh bentuk kadoData-nya:
//   fingerprint: { "holdMs": 3000, "hint": "Tahan sidikmu di layar 3 detik…" }
//   quiz:        { "question": "Kapan kita jalan?", "answer": "Minggu", "hint": "Hari di akhir pekan" }
//   tap:         { "taps": 5, "hint": "Ketuk 5 kali pelan-pelan" }
//   scratch:     { "coverText": "Ada hadiah di baliknya ✨", "hint": "Gosok pelan-pelan" }
//
// status: "pending" (belum dibuka) → "opened" (sudah dibuka)
//         → "accepted" | "rejected" (keputusan penerima).
// Nilai kadoType/status divalidasi di lapisan API (zod), bukan constraint DB —
// supaya tipe/status baru tetap bisa masuk tanpa menyentuh schema.
// ─────────────────────────────────────────────────────────────────────────────
model Kado {
  id           String   @id @default(uuid()) @db.Uuid
  targetName   String // nama penerima kado
  message      String // isi pesan utama
  senderName   String? // nama asli pengirim — null kalau anonim
  fomoInitials String? // inisial bertopeng pengirim, mis. "R***I" (src/utils/fomoLogic.ts)
  kadoType     String // fingerprint | quiz | tap | scratch | (tipe baru bebas)
  kadoData     Json? // konfigurasi spesifik per kadoType — lihat contoh di atas
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([kadoType])
}
